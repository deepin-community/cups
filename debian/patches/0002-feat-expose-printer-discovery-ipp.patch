From a02c2b1d6154909cfc524cf0bc5c3251dd8e269a Mon Sep 17 00:00:00 2001
From: LIU Li <liuli@uniontech.com>
Date: Fri, 16 Oct 2026 13:21:51 +0800
Subject: [PATCH] feat: expose printer-discovery-enabled via IPP attribute

Parse the DisableAvahiBrowsing directive in cupsd and expose the printer
discovery setting via a public IPP attribute so clients can read it
without admin authentication, including inside containers.

cupsd 解析 DisableAvahiBrowsing 指令并通过公开 IPP 属性
printer-discovery-enabled 暴露网络发现开关，客户端无需管理员认证即可
读取，容器内也能正确获取服务配置。

Log: 通过 IPP 属性暴露并读取网络发现开关
Influence: 容器内客户端无需管理员认证即可正确读取网络发现配置。
Change-Id: Ia36691dd864458ef8606f1e84418abe65a997b3b
---

diff --git a/cups/dest.c b/cups/dest.c
index 1d3c457..992e4df 100644
--- a/cups/dest.c
+++ b/cups/dest.c
@@ -3387,6 +3387,36 @@
 
 
 /*
+ * '_cups_get_printer_discovery_enabled()' - Get whether network printer
+ *                                            discovery is enabled.
+ */
+
+static int				/* O - 1 if enabled, 0 otherwise */
+_cups_get_printer_discovery_enabled(
+    http_t *http)			/* I - Connection to scheduler */
+{
+  int			enabled = 0;	/* Discovery enabled? */
+  ipp_t			*request,	/* IPP request */
+			*response;	/* IPP response */
+  ipp_attribute_t	*attr;		/* Attribute */
+
+
+  request = ippNewRequest(IPP_OP_CUPS_GET_DEFAULT);
+
+  if ((response = cupsDoRequest(http, request, "/")) != NULL)
+  {
+    if ((attr = ippFindAttribute(response, "printer-discovery-enabled",
+                                 IPP_TAG_BOOLEAN)) != NULL)
+      enabled = ippGetBoolean(attr, 0);
+
+    ippDelete(response);
+  }
+
+  return (enabled);
+}
+
+
+/*
  * 'cups_enum_dests()' - Enumerate destinations from a specific server.
  */
 
